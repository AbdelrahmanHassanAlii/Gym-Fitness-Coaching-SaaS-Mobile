# Public Expo client configuration only.
# Values prefixed with EXPO_PUBLIC_ are bundled into shipped client code.

# local | development | staging | production
EXPO_PUBLIC_APP_ENV=local

# Point this at the standalone Backend API for the environment you are running.
# Examples:
# - Local desktop server from iOS simulator: http://localhost:3000
# - Local desktop server from Android emulator: http://10.0.2.2:3000
# - Physical devices usually need a LAN-reachable host such as http://192.168.1.10:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
